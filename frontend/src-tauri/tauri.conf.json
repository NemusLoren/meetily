{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Trascrivi Seduta",
    "version": "0.5.0",
    "identifier": "it.trascriviseduta.app",
    "build": {
        "frontendDist": "../out",
        "devUrl": "http://localhost:3118",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "title": "Trascrivi Seduta",
                "width": 1100,
                "height": 700,
                "preventOverflow": true,
                "resizable": true,
                "fullscreen": false,
                "theme": "Light",
                "decorations": true
            }
        ],
        "macOSPrivateApi": true,
        "security": {
            "csp": {
                "default-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' asset: http://asset.localhost https://asset.localhost data:",
                "connect-src": "'self' http://localhost:11434 http://localhost:5167 http://localhost:8178"
            },
            "capabilities": [
                {
                    "identifier": "main",
                    "description": "Main window capability with file system and media access",
                    "windows": [
                        "main"
                    ],
                    "permissions": [
                        "fs:default",
                        "fs:allow-read-file",
                        "fs:read-all",
                        "fs:write-all",
                        "fs:allow-app-read",
                        "fs:allow-app-write",
                        "fs:allow-download-write",
                        "fs:allow-download-read",
                        "fs:scope-download",
                        "core:path:default",
                        "core:event:default",
                        "core:window:default",
                        "core:app:default",
                        "core:resources:default",
                        "core:menu:default",
                        "core:tray:default",
                        "core:window:allow-set-title",
                        "store:default",
                        "notification:default",
                        "notification:allow-is-permission-granted",
                        "process:default",
                        {
                            "identifier": "fs:scope",
                            "allow": [
                                {
                                    "path": "$APPDATA/*"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    },
    "bundle": {
        "active": true,
        "shortDescription": "Trascrizione privata delle sedute cliniche",
        "longDescription": "Trascrivi Seduta è un software gratuito e open source per psicologi e psicoterapeuti: registra le sedute, trascrive l'audio in locale e crea riassunti con modelli locali. Registrazioni e trascrizioni restano sul tuo computer. Basato su Meetily.",
        "category": "Productivity",
        "publisher": "Trascrivi Seduta",
        "homepage": "https://github.com/NemusLoren/Meetily-ai",
        "targets": [
            "deb",
            "appimage",
            "msi",
            "nsis",
            "app",
            "dmg"
        ],
        "createUpdaterArtifacts": false,
        "icon": [
            "icons/icon.png",
            "icons/icon_512x512.png",
            "icons/icon_256x256.png",
            "icons/128x128.png",
            "icons/32x32.png",
            "icons/icon_16x16.png",
            "icons/app_icon.icns",
            "icons/app_icon.ico"
        ],
        "resources": [
            "templates/*.json"
        ],
        "externalBin": [
            "binaries/llama-helper",
            "binaries/ffmpeg"
        ],
        "linux": {
            "deb": {
                "depends": ["libvulkan1", "libpulse0", "libasound2"]
            }
        },
        "macOS": {
            "entitlements": "entitlements.plist",
            "signingIdentity": "-",
            "hardenedRuntime": true
        },
        "windows": {
            "signCommand": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -FilePath %1"
        }
    }
}
